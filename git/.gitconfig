[init]
    defaultBranch = main

[core]
    editor = nvim
    preloadindex = true
    fscache = true
    untrackedCache = true
    checkStat = minimal
    autocrlf = input
    excludesfile = ~/.gitignore_global
    pager = delta

[color]
    ui = auto

[merge]
    conflictstyle = diff3

[diff]
    colorMoved = default

[pull]
    rebase = false

[push]
    default = current
    autoSetupRemote = true

[include]
    path = ~/.gitconfig.local

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true
    light = false
    line-numbers = true
    side-by-side = false
    syntax-theme = Dracula
    merge-conflict-style-bold = true

[alias]
    st = status -sb
    lg = log --oneline --graph --all --decorate
    ll = log --pretty=format:'%C(yellow)%h%Creset %s %C(cyan)<%an>%Creset %C(green)(%cr)%Creset' --abbrev-commit
    last = log -1 HEAD --stat
    br = branch -vv
    bra = branch -a -vv
    bd = branch -d
    bD = branch -D
    co = checkout
    sw = switch
    swc = switch -c
    ci = commit
    ca = commit --amend
    can = commit --amend --no-edit
    df = diff
    dfs = diff --staged
    dfw = diff --word-diff
    unstage = reset HEAD --
    uncommit = reset --soft HEAD~1
    stl = stash list
    stp = stash pop
    sts = stash show -p
    pu = push
    puf = push --force-with-lease
    pl = pull
    fe = fetch --all --prune
    wt = worktree
    wtl = worktree list
    wta = worktree add
    wtr = worktree remove
    cleanup = "!git branch --merged | grep -v '\\*\\|main\\|master\\|develop' | xargs -n 1 git branch -d"
