# Readline config. Every readline program reads this file (psql, python,
# gdb), so everything but the system defaults is scoped to bash. ble.sh
# rebuilds its key bindings from this file.

$include /etc/inputrc

$if Bash
    # Completion: case-insensitive, list on the first Tab, colored like ls
    set completion-ignore-case on
    set show-all-if-ambiguous on
    set colored-stats on
    set mark-symlinked-directories on

    # Up/Down search history for lines starting with what is already typed
    "\e[A": history-search-backward
    "\e[B": history-search-forward
    "\eOA": history-search-backward
    "\eOB": history-search-forward
$endif
