#!/usr/bin/env bash
# dotfiles - Manage your dotfiles installation
# Usage: dotfiles <command>
#   dotfiles doctor  - Check health of installation
#   dotfiles update  - Pull latest and restow
#   dotfiles upgrade - Reinstall selected tool categories at their latest release
#   dotfiles edit    - Open dotfiles in editor
#   dotfiles sync    - Copy configs to Windows side (WSL only)

set -euo pipefail

DOTFILES_DIR="$HOME/repos/dotfiles"

IS_WSL=0
if [[ -f /proc/version ]] && grep -qi microsoft /proc/version 2>/dev/null; then
    IS_WSL=1
fi

DOCTOR_FAILURES=0

# Colors
if [[ -t 1 ]]; then
    GREEN='\033[0;32m' RED='\033[0;31m' YELLOW='\033[0;33m'
    CYAN='\033[0;36m' DIM='\033[2m' BOLD='\033[1m' RESET='\033[0m'
else
    GREEN='' RED='' YELLOW='' CYAN='' DIM='' BOLD='' RESET=''
fi

ok()   { echo -e "  ${GREEN}✓${RESET} $*"; }
fail() {
    echo -e "  ${RED}✗${RESET} $*"
    ((DOCTOR_FAILURES += 1))
}
warn() { echo -e "  ${YELLOW}!${RESET} $*"; }
info() { echo -e "  ${CYAN}ℹ${RESET} $*"; }
skip() { echo -e "  ${DIM}-${RESET} $*"; }

check_symlink() {
    local target="$1" desc="$2"
    if [[ -L "$target" && -e "$target" ]]; then
        ok "$desc"
    elif [[ -L "$target" ]]; then
        fail "$desc (dangling symlink; run: dotfiles update)"
    elif [[ -e "$target" ]]; then
        warn "$desc (exists but not a symlink)"
    else
        fail "$desc (missing)"
    fi
}

# Run a command line on a real pty under a cold environment and print what it
# wrote. Arguments before -- are environment assignments. Needs util-linux
# script (has_pty_script); the environment travels through env, not through
# the command string, so nothing in it needs quoting.
has_pty_script() { script --version 2>/dev/null | grep -q util-linux; }
on_pty() {
    local assigns=()
    while [[ $# -gt 0 && "$1" != "--" ]]; do assigns+=("$1"); shift; done
    shift
    timeout 20 env -i HOME="$HOME" USER="${USER:-}" TERM=xterm-256color PATH=/usr/bin:/bin HISTFILE=/dev/null \
        ${assigns[@]+"${assigns[@]}"} script -qec "$1" /dev/null 2>/dev/null | tr -d '\r' || true
}

# Which shell answers at the prompt of an interactive bash on a real pty:
# prints "bash" or "zsh". Arguments are environment assignments for that bash.
# The commands start with a space so zsh keeps them out of its history.
pty_shell() {
    printf ' printf "__pty_shell=%%s\\n" "${BASH_VERSION:+bash}${ZSH_VERSION:+zsh}"\n exit\n' \
        | on_pty "$@" -- 'bash -i' | sed -nE 's/.*__pty_shell=(bash|zsh)$/\1/p' | tail -n 1
}

check_pty_shell() {
    local want="$1" desc="$2" got
    shift 2
    got="$(pty_shell "$@")"
    if [[ "$got" == "$want" ]]; then ok "$desc"; else fail "$desc (prompt was answered by ${got:-nothing}, expected $want)"; fi
}

check_cmd() {
    local cmd="$1" desc="${2:-$1}"
    if command -v "$cmd" &>/dev/null; then
        local version_output ver
        case "$cmd" in
            tmux) version_output="$(tmux -V 2>/dev/null || true)" ;;
            *) version_output="$("$cmd" --version 2>/dev/null || true)" ;;
        esac
        ver="$(grep -oE '[0-9]+\.[0-9]+(\.[0-9]+)?' <<< "$version_output" | head -1 || true)"
        ok "$desc${ver:+ ($ver)}"
    else
        fail "$desc (not installed)"
    fi
}

doctor() {
    DOCTOR_FAILURES=0
    echo -e "${BOLD}Dotfiles Health Check${RESET}"
    echo ""

    echo -e "${CYAN}Symlinks${RESET}"
    check_symlink "$HOME/.bashrc" ".bashrc"
    check_symlink "$HOME/.bash_profile" ".bash_profile"
    check_symlink "$HOME/.inputrc" ".inputrc"
    check_symlink "$HOME/.zshrc" ".zshrc"
    check_symlink "$HOME/.bash/aliases.sh" ".bash/aliases.sh"
    check_symlink "$HOME/.bash/functions.sh" ".bash/functions.sh"
    check_symlink "$HOME/.bash/path.sh" ".bash/path.sh"
    check_symlink "$HOME/.bash/toolchains.sh" ".bash/toolchains.sh"
    check_symlink "$HOME/.gitconfig" ".gitconfig"
    check_symlink "$HOME/.gitignore_global" ".gitignore_global"
    check_symlink "$HOME/.tmux.conf" ".tmux.conf"
    if [[ "$IS_WSL" -eq 1 ]]; then
        skip ".wezterm.lua (Linux copy is unused on WSL)"
        local windows_profile win_home
        if cmd.exe /d /c exit &>/dev/null; then
            ok "Windows executable interop"
            windows_profile="$(cd /mnt/c && cmd.exe /d /c 'echo %USERPROFILE%' 2>/dev/null | tr -d '\r')"
        else
            fail "Windows executable interop (WSLInterop registration is missing)"
            windows_profile="$(
                cd /mnt/c
                /init /mnt/c/Windows/System32/cmd.exe /d /c 'echo %USERPROFILE%' 2>/dev/null \
                    | tr -d '\r'
            )"
        fi
        win_home="$(wslpath -u "$windows_profile" 2>/dev/null || true)"
        local win_wezterm="$win_home/.wezterm.lua"
        if [[ -n "$win_home" && -f "$win_wezterm" ]]; then
            # Check if Windows copy is current
            if ! render_windows_wezterm 2>/dev/null | diff -q - "$win_wezterm" &>/dev/null; then
                warn ".wezterm.lua (Windows copy is stale - run: dotfiles sync)"
            else
                ok ".wezterm.lua (Windows copy)"
            fi
        elif [[ -n "$win_home" ]]; then
            fail ".wezterm.lua (Windows copy missing at $win_wezterm)"
        fi
    else
        check_symlink "$HOME/.wezterm.lua" ".wezterm.lua"
    fi

    echo ""
    echo -e "${CYAN}Shell${RESET}"
    check_cmd bash "Bash"
    local login_shell
    if [[ "$OSTYPE" == "darwin"* ]]; then
        login_shell="$(dscl . -read "$HOME" UserShell 2>/dev/null | awk '{print $2}')"
    else
        login_shell="$(getent passwd "$USER" | cut -d: -f7)"
    fi
    if [[ "$(basename "${login_shell:-none}")" == "bash" ]]; then
        ok "login shell is bash ($login_shell)"
    else
        fail "login shell is ${login_shell:-unknown}, not bash (Codex and new terminals follow it; run: chsh -s \"\$(command -v bash)\")"
    fi
    check_cmd zsh "zsh (terminals hand off to it)"
    if [[ -f "$HOME/.oh-my-zsh/oh-my-zsh.sh" ]]; then ok "oh-my-zsh"; else fail "oh-my-zsh (not installed; run: bash install.sh --section shell)"; fi
    local plugin
    for plugin in zsh-autosuggestions zsh-syntax-highlighting; do
        if [[ -d "$HOME/.oh-my-zsh/custom/plugins/$plugin" || -d "/opt/homebrew/share/$plugin" || -d "/usr/local/share/$plugin" ]]; then
            ok "$plugin"
        else
            fail "$plugin (not installed; run: bash install.sh --section shell)"
        fi
    done
    # ~/.zshrc sources the ~/.bash files unchanged, so a bash-only construct in
    # one of them breaks every terminal while agents keep working. This starts
    # the real zsh on a pty, as a terminal does, and types at its prompt:
    # startup must write nothing to stderr, and one name from each shared file
    # must be defined.
    if ! command -v zsh &>/dev/null; then
        :
    elif has_pty_script; then
        local zsh_err zsh_loaded
        zsh_err="$(mktemp)"
        # shellcheck disable=SC2016  # expanded by zsh and by script's sh, not here
        zsh_loaded="$(printf ' print -r -- "__zsh_loaded=$(( $+functions[path_prepend] && $+functions[venv] && $+aliases[gs] && $+functions[extract] ))"\n exit\n' \
            | on_pty ZSH_ERR="$zsh_err" -- 'zsh -i 2>"$ZSH_ERR"' | sed -nE 's/.*__zsh_loaded=([01])$/\1/p' | tail -n 1)"
        if [[ -s "$zsh_err" ]]; then
            fail "zsh startup printed errors (a shared .bash/*.sh file or .zshrc):"
            sed 's/^/      /' "$zsh_err"
        elif [[ "$zsh_loaded" == "1" ]]; then
            ok "zsh starts clean with the shared .bash/*.sh files loaded"
        elif [[ "$zsh_loaded" == "0" ]]; then
            fail ".zshrc did not load the shared .bash/*.sh files (path_prepend, venv, gs, extract)"
        else
            fail "zsh did not answer at its prompt within 20s"
        fi
        rm -f "$zsh_err"
    else
        skip "zsh startup check (needs util-linux script)"
    fi
    # Installers append to rc files. After the handoff in .bashrc such a line
    # never runs, in .bash_profile it reaches agents but no terminal, and in
    # .zshrc or .zshenv it reaches terminals but no agent.
    local rc
    for rc in .bash_profile .bashrc .zshrc; do
        [[ -f "$HOME/$rc" ]] || continue
        if [[ "$(tail -n 1 "$HOME/$rc")" == "# end of $rc" ]]; then
            ok "$rc has nothing appended"
        else
            fail "$rc has lines after '# end of $rc' (PATH and exports go in ~/.bash/path.sh or local.sh, which both shells load)"
        fi
    done
    if [[ -s "$HOME/.zshenv" ]]; then
        warn ".zshenv exists: zsh terminals read it, agents never do (move what is needed to ~/.bash/local.sh or path.sh, then delete it)"
    fi
    # Left behind by earlier layouts of this repo
    local link stale=""
    for link in "$HOME"/.[!.]* "$HOME"/.bash/* "$HOME"/.zsh/* "$HOME"/.local/bin/*; do
        if [[ -L "$link" && ! -e "$link" && "$(readlink "$link")" == *repos/dotfiles/* ]]; then
            stale+="      $link"$'\n'
        fi
    done
    if [[ -n "$stale" ]]; then
        fail "dangling links to files this repo no longer has (delete them):"
        printf '%s' "$stale"
    fi
    if [[ -f "$HOME/.zsh/local.zsh" ]]; then
        warn ".zsh/local.zsh is no longer read (move what is still needed to ~/.bash/local.sh, then delete it)"
    fi
    if [[ -d "$HOME/.local/share/blesh" ]]; then
        warn "ble.sh is no longer used (close terminals still running it, then: rm -rf ~/.local/share/blesh ~/.cache/blesh ~/.local/state/blesh)"
    fi
    if [[ -f "$HOME/.bash/local.sh" ]]; then ok "local.sh (machine overrides)"; else skip "local.sh (not created yet)"; fi

    echo ""
    echo -e "${CYAN}Tools${RESET}"
    check_cmd git "Git"
    check_cmd nvim "Neovim"
    check_cmd tmux "tmux"
    check_cmd fzf "fzf"
    check_cmd rg "ripgrep"
    if command -v bat &>/dev/null; then check_cmd bat "bat"; else check_cmd batcat "bat (batcat)"; fi
    check_cmd zoxide "zoxide"
    check_cmd delta "git-delta"
    check_cmd gh "GitHub CLI"
    check_cmd lazygit "lazygit"
    check_cmd stow "GNU stow"
    check_cmd glab "GitLab CLI"
    check_cmd shellcheck "ShellCheck"
    check_cmd yq "yq"
    check_cmd mongosh "mongosh"
    check_cmd psql "psql"
    check_cmd typst "Typst"
    check_cmd pandoc "Pandoc"

    echo ""
    echo -e "${CYAN}Kubernetes and secrets${RESET}"
    local tool
    for tool in kubectl helm k9s argocd minikube linkerd sops age; do
        if command -v "$tool" &>/dev/null; then ok "$tool"; else fail "$tool (not installed)"; fi
    done

    echo ""
    echo -e "${CYAN}Languages${RESET}"
    check_cmd python3 "Python"
    check_cmd uv "uv"
    if [[ -s "$HOME/.nvm/nvm.sh" ]]; then
        local nver
        nver="$(cat "$HOME/.nvm/alias/default" 2>/dev/null)"
        ok "nvm (default: ${nver:-none})"
    else
        fail "nvm (not installed)"
    fi
    check_cmd go "Go"
    check_cmd rustc "Rust"
    check_cmd cargo "Cargo"
    for tool in dlv govulncheck golangci-lint; do
        if command -v "$tool" &>/dev/null; then ok "$tool"; else fail "$tool (not installed; run setup/go.sh)"; fi
    done

    echo ""
    echo -e "${CYAN}Agent shell${RESET} ${DIM}(.bashrc as Claude Code / Codex snapshot it: non-interactive login, cold PATH)${RESET}"
    local probe node_path alias_count prompt_cmd dupes
    probe="$(env -i HOME="$HOME" USER="${USER:-}" PATH=/usr/bin:/bin bash -lc '
        source ~/.bashrc
        printf "node=%s\n" "$(type -P node)"
        printf "aliases=%s\n" "$(alias | wc -l | tr -d " ")"
        printf "prompt_cmd=%s\n" "${PROMPT_COMMAND:-none}"
        printf "dupes=%s\n" "$(tr : "\n" <<< "$PATH" | sort | uniq -d | wc -l | tr -d " ")"
    ' 2>&1)"
    node_path="$(sed -n 's/^node=//p' <<< "$probe")"
    alias_count="$(sed -n 's/^aliases=//p' <<< "$probe")"
    prompt_cmd="$(sed -n 's/^prompt_cmd=//p' <<< "$probe")"
    dupes="$(sed -n 's/^dupes=//p' <<< "$probe")"
    if [[ -x "$node_path" ]]; then ok "node resolves to a binary ($node_path)"; else fail "node does not resolve to a binary (got '${node_path:-nothing}')"; fi
    if [[ "$alias_count" == "0" ]]; then ok "no aliases"; else fail "${alias_count:-?} aliases leak into agent shells"; fi
    if [[ "$prompt_cmd" == "none" ]]; then ok "no prompt hooks"; else fail "PROMPT_COMMAND leaks into agent shells ($prompt_cmd)"; fi
    if [[ "$dupes" == "0" ]]; then ok "no duplicate PATH entries after sourcing .bashrc twice"; else fail "$dupes duplicate PATH entries"; fi
    if grep -qvE '^(node|aliases|prompt_cmd|dupes)=' <<< "$probe"; then
        warn "agent shell startup printed output (should be silent):"
        grep -vE '^(node|aliases|prompt_cmd|dupes)=' <<< "$probe" | sed 's/^/      /'
    fi
    # Agent Overflow reads PATH from `bash -ilc`: interactive flag, but a
    # command string, so it must stay in bash, get environment only and
    # return promptly
    local ao_probe
    if ao_probe="$(timeout 10 env -i HOME="$HOME" USER="${USER:-}" TERM=dumb PATH=/usr/bin:/bin bash -ilc 'printf "shell=%s aliases=%s\n" "${BASH_VERSION:+bash}" "$(alias | wc -l | tr -d " ")"' 2>/dev/null </dev/null)"; then
        if [[ "$ao_probe" == "shell=bash aliases=0" ]]; then
            ok "bash -ilc stays in bash, environment only"
        else
            fail "bash -ilc: expected bash with no aliases, got '${ao_probe:-nothing}'"
        fi
    else
        fail "bash -ilc did not finish within 10s"
    fi
    # A machine whose login shell is still zsh sends agents through .zshrc,
    # which has to give them environment only as well
    if command -v zsh &>/dev/null; then
        local zsh_probe
        zsh_probe="$(timeout 10 env -i HOME="$HOME" USER="${USER:-}" TERM=dumb PATH=/usr/bin:/bin zsh -ilc 'print -r -- "aliases=$(alias | wc -l | tr -d " ") hooks=${#precmd_functions}"' 2>/dev/null </dev/null | tail -n 1 || true)"
        if [[ "$zsh_probe" == "aliases=0 hooks=0" ]]; then
            ok "zsh -ilc gets environment only"
        else
            fail "zsh -ilc: expected no aliases and no prompt hooks, got '${zsh_probe:-nothing}'"
        fi
    fi
    # The handoff on a real pty: a terminal becomes zsh, while an agent's
    # interactive shell and an opted-out one stay bash
    if has_pty_script; then
        check_pty_shell zsh "a terminal hands off to zsh"
        check_pty_shell bash "an interactive shell with an agent marker stays bash" CLAUDECODE=1
        check_pty_shell bash "DOTFILES_BASH=1 keeps bash" DOTFILES_BASH=1
    else
        skip "handoff on a pty (needs util-linux script)"
    fi

    if [[ "$IS_WSL" -eq 1 ]]; then
        echo ""
        echo -e "${CYAN}WSL${RESET}"
        if systemctl is-active --quiet earlyoom.service; then
            ok "earlyoom running"
        else
            fail "earlyoom not running (run setup/wsl.sh)"
        fi
    fi

    echo ""
    echo -e "${CYAN}SSH${RESET}"
    if [[ -f "$HOME/.ssh/id_ed25519" ]]; then
        ok "SSH key (ed25519)"
    elif [[ -f "$HOME/.ssh/id_rsa" ]]; then
        warn "SSH key (rsa - consider switching to ed25519)"
    else
        fail "No SSH key found"
    fi

    echo ""
    echo -e "${CYAN}Config${RESET}"
    if [[ -f "$HOME/.gitconfig.local" ]]; then ok ".gitconfig.local"; else warn ".gitconfig.local (no local git config)"; fi
    if [[ -d "$HOME/.config/nvim" ]]; then ok "Neovim config"; else fail "Neovim config (missing ~/.config/nvim)"; fi
    if [[ -d "$HOME/.tmux/plugins/tpm" ]]; then ok "TPM (tmux plugins)"; else fail "TPM (not installed)"; fi

    echo ""
    if [[ "$DOCTOR_FAILURES" -eq 0 ]]; then
        ok "No health-check failures"
    else
        fail "$DOCTOR_FAILURES health-check failure(s)"
        return 1
    fi
}

update() {
    echo "Updating dotfiles..."
    cd "$DOTFILES_DIR"
    local packages=(shell git tmux wezterm bin) pkg file link before
    # Stow visits only the directories a package still has, so the link for a
    # file the pull deletes can be left dangling. Remember what was linked.
    before="$(git ls-files -- "${packages[@]}")"
    git pull --rebase

    echo "Restowing packages..."
    for pkg in "${packages[@]}"; do
        if [[ -d "$DOTFILES_DIR/$pkg" ]]; then
            stow --restow --no-folding --target="$HOME" "$pkg" 2>/dev/null && echo "  ✓ $pkg" || echo "  ✗ $pkg (conflict)"
        fi
    done
    while IFS= read -r file; do
        link="$HOME/${file#*/}"
        if [[ ! -e "$DOTFILES_DIR/$file" && -L "$link" && ! -e "$link" ]]; then
            rm -- "$link"
            echo "  ✓ removed the link for deleted $file"
        fi
    done <<< "$before"

    echo "Done."
}

# oh-my-zsh and the two plugins are git clones. .zshrc turns off oh-my-zsh's
# own update check, so this is what updates them.
upgrade_zsh() {
    local dir
    for dir in "$HOME/.oh-my-zsh" \
        "$HOME/.oh-my-zsh/custom/plugins/zsh-autosuggestions" \
        "$HOME/.oh-my-zsh/custom/plugins/zsh-syntax-highlighting"; do
        if [[ -d "$dir/.git" ]]; then
            echo "Updating ${dir##*/}..."
            git -C "$dir" pull --ff-only --quiet || {
                echo "  ✗ ${dir##*/}: git pull failed in $dir" >&2
                return 1
            }
        else
            echo "  - ${dir##*/} is not a git clone at $dir (run: bash install.sh --section shell)"
        fi
    done
}

# Categories: go, nvim and zsh here, the rest belong to setup/user-tools.sh.
upgrade() {
    if [[ $# -eq 0 ]]; then
        echo "Usage: dotfiles upgrade <category...|all>"
        echo "  go       Go toolchain, dlv, govulncheck, golangci-lint"
        echo "  nvim     Neovim"
        echo "  zsh      oh-my-zsh, zsh-autosuggestions, zsh-syntax-highlighting"
        bash "$DOTFILES_DIR/setup/user-tools.sh" --help | tail -n +3
        return 1
    fi

    local category user_categories=() run_go=0 run_nvim=0 run_zsh=0 run_user=0
    for category in "$@"; do
        case "$category" in
            all) run_go=1; run_nvim=1; run_zsh=1; run_user=1 ;;
            go) run_go=1 ;;
            nvim) run_nvim=1 ;;
            zsh) run_zsh=1 ;;
            *) user_categories+=("$category"); run_user=1 ;;
        esac
    done

    if [[ "$run_user" -eq 1 ]]; then
        bash "$DOTFILES_DIR/setup/user-tools.sh" --upgrade "${user_categories[@]}"
    fi
    if [[ "$run_go" -eq 1 ]]; then
        UPGRADE=1 bash "$DOTFILES_DIR/setup/go.sh"
    fi
    if [[ "$run_nvim" -eq 1 ]]; then
        bash "$DOTFILES_DIR/install.sh" --section neovim
    fi
    if [[ "$run_zsh" -eq 1 ]]; then
        upgrade_zsh
    fi
}

edit() {
    cd "$DOTFILES_DIR"
    "${EDITOR:-nvim}" .
}

sync() {
    if [[ "$IS_WSL" -eq 0 ]]; then
        info "sync is only needed on WSL"
        return 0
    fi
    local windows_profile win_home=""
    # From /mnt/c, with stdin closed: cmd.exe in a Linux cwd warns about UNC
    # paths, and it reads (and eats) any piped stdin.
    windows_profile="$(cd /mnt/c && cmd.exe /d /c 'echo %USERPROFILE%' </dev/null 2>/dev/null | tr -d '\r')" || true
    # wslpath "" prints ".", which would write into the current directory.
    if [[ -n "$windows_profile" ]]; then
        win_home="$(wslpath -u "$windows_profile" 2>/dev/null || true)"
    fi
    if [[ "$win_home" != /* || ! -d "$win_home" ]]; then
        fail "Could not detect Windows home directory"
        return 1
    fi
    local rendered
    rendered="$(render_windows_wezterm)" || return 1
    printf '%s\n' "$rendered" > "$win_home/.wezterm.lua"
    ok "Copied .wezterm.lua to Windows ($win_home), default distro $WSL_DISTRO_NAME"
}

# The Windows copy opens the distro it was synced from. WSL_DISTRO in the
# Windows environment still overrides it when WezTerm starts.
render_windows_wezterm() {
    local src="$DOTFILES_DIR/wezterm/.wezterm.lua"
    local pattern="os.getenv('WSL_DISTRO') or '[^']*'"
    if [[ ! -f "$src" ]]; then
        fail "Source not found: $src"
        return 1
    fi
    if [[ -z "${WSL_DISTRO_NAME:-}" ]]; then
        fail "WSL_DISTRO_NAME is not set; cannot name the distro for WezTerm"
        return 1
    fi
    if ! grep -q "$pattern" "$src"; then
        fail "$src no longer has the WSL_DISTRO fallback this sync rewrites"
        return 1
    fi
    sed "s/$pattern/os.getenv('WSL_DISTRO') or '$WSL_DISTRO_NAME'/" "$src"
}

case "${1:-help}" in
    doctor) doctor ;;
    update) update ;;
    upgrade) shift; upgrade "$@" ;;
    edit)   edit ;;
    sync)   sync ;;
    *)
        echo "Usage: dotfiles <command>"
        echo ""
        echo "Commands:"
        echo "  doctor  Check health of installation"
        echo "  update  Pull latest and restow all packages"
        echo "  upgrade Reinstall tool categories at their latest release (no args: list)"
        echo "  edit    Open dotfiles repo in editor"
        echo "  sync    Copy configs to Windows side (WSL only)"
        ;;
esac
