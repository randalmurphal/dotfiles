#!/usr/bin/env bash
# dotfiles - Manage your dotfiles installation
# Usage: dotfiles <command>
#   dotfiles doctor  - Check health of installation
#   dotfiles update  - Pull latest and restow
#   dotfiles upgrade - Reinstall selected tool categories at their latest release
#   dotfiles edit    - Open dotfiles in editor
#   dotfiles sync    - Copy configs to Windows side (WSL only)

set -euo pipefail

DOTFILES_DIR="$HOME/repos/dotfiles"

IS_WSL=0
if [[ -f /proc/version ]] && grep -qi microsoft /proc/version 2>/dev/null; then
    IS_WSL=1
fi

DOCTOR_FAILURES=0

# Colors
if [[ -t 1 ]]; then
    GREEN='\033[0;32m' RED='\033[0;31m' YELLOW='\033[0;33m'
    CYAN='\033[0;36m' DIM='\033[2m' BOLD='\033[1m' RESET='\033[0m'
else
    GREEN='' RED='' YELLOW='' CYAN='' DIM='' BOLD='' RESET=''
fi

ok()   { echo -e "  ${GREEN}✓${RESET} $*"; }
fail() {
    echo -e "  ${RED}✗${RESET} $*"
    ((DOCTOR_FAILURES += 1))
}
warn() { echo -e "  ${YELLOW}!${RESET} $*"; }
info() { echo -e "  ${CYAN}ℹ${RESET} $*"; }
skip() { echo -e "  ${DIM}-${RESET} $*"; }

check_symlink() {
    local target="$1" desc="$2"
    if [[ -L "$target" ]]; then
        ok "$desc"
    elif [[ -e "$target" ]]; then
        warn "$desc (exists but not a symlink)"
    else
        fail "$desc (missing)"
    fi
}

check_cmd() {
    local cmd="$1" desc="${2:-$1}"
    if command -v "$cmd" &>/dev/null; then
        local version_output ver
        case "$cmd" in
            tmux) version_output="$(tmux -V 2>/dev/null || true)" ;;
            *) version_output="$("$cmd" --version 2>/dev/null || true)" ;;
        esac
        ver="$(grep -oE '[0-9]+\.[0-9]+(\.[0-9]+)?' <<< "$version_output" | head -1 || true)"
        ok "$desc${ver:+ ($ver)}"
    else
        fail "$desc (not installed)"
    fi
}

doctor() {
    DOCTOR_FAILURES=0
    echo -e "${BOLD}Dotfiles Health Check${RESET}"
    echo ""

    echo -e "${CYAN}Symlinks${RESET}"
    check_symlink "$HOME/.zshrc" ".zshrc"
    check_symlink "$HOME/.zsh/core.zsh" ".zsh/core.zsh"
    check_symlink "$HOME/.zsh/aliases.zsh" ".zsh/aliases.zsh"
    check_symlink "$HOME/.zsh/functions.zsh" ".zsh/functions.zsh"
    check_symlink "$HOME/.zsh/path.zsh" ".zsh/path.zsh"
    check_symlink "$HOME/.zsh/toolchains.zsh" ".zsh/toolchains.zsh"
    check_symlink "$HOME/.gitconfig" ".gitconfig"
    check_symlink "$HOME/.gitignore_global" ".gitignore_global"
    check_symlink "$HOME/.tmux.conf" ".tmux.conf"
    if [[ "$IS_WSL" -eq 1 ]]; then
        skip ".wezterm.lua (Linux copy is unused on WSL)"
        local windows_profile win_home
        if cmd.exe /d /c exit &>/dev/null; then
            ok "Windows executable interop"
            windows_profile="$(cd /mnt/c && cmd.exe /d /c 'echo %USERPROFILE%' 2>/dev/null | tr -d '\r')"
        else
            fail "Windows executable interop (WSLInterop registration is missing)"
            windows_profile="$(
                cd /mnt/c
                /init /mnt/c/Windows/System32/cmd.exe /d /c 'echo %USERPROFILE%' 2>/dev/null \
                    | tr -d '\r'
            )"
        fi
        win_home="$(wslpath -u "$windows_profile" 2>/dev/null || true)"
        local win_wezterm="$win_home/.wezterm.lua"
        if [[ -n "$win_home" && -f "$win_wezterm" ]]; then
            # Check if Windows copy is current
            if ! render_windows_wezterm 2>/dev/null | diff -q - "$win_wezterm" &>/dev/null; then
                warn ".wezterm.lua (Windows copy is stale - run: dotfiles sync)"
            else
                ok ".wezterm.lua (Windows copy)"
            fi
        elif [[ -n "$win_home" ]]; then
            fail ".wezterm.lua (Windows copy missing at $win_wezterm)"
        fi
    else
        check_symlink "$HOME/.wezterm.lua" ".wezterm.lua"
    fi

    echo ""
    echo -e "${CYAN}Shell${RESET}"
    check_cmd zsh "ZSH"
    if [[ -d "$HOME/.oh-my-zsh" ]]; then ok "oh-my-zsh"; else fail "oh-my-zsh (not installed)"; fi
    if [[ -d "$HOME/.oh-my-zsh/custom/plugins/zsh-autosuggestions" ]]; then ok "zsh-autosuggestions"; else fail "zsh-autosuggestions"; fi
    if [[ -d "$HOME/.oh-my-zsh/custom/plugins/zsh-syntax-highlighting" ]]; then ok "zsh-syntax-highlighting"; else fail "zsh-syntax-highlighting"; fi
    if [[ -f "$HOME/.zsh/local.zsh" ]]; then ok "local.zsh (machine overrides)"; else skip "local.zsh (not created yet)"; fi

    echo ""
    echo -e "${CYAN}Tools${RESET}"
    check_cmd git "Git"
    check_cmd nvim "Neovim"
    check_cmd tmux "tmux"
    check_cmd fzf "fzf"
    check_cmd rg "ripgrep"
    if command -v bat &>/dev/null; then check_cmd bat "bat"; else check_cmd batcat "bat (batcat)"; fi
    check_cmd zoxide "zoxide"
    check_cmd delta "git-delta"
    check_cmd gh "GitHub CLI"
    check_cmd lazygit "lazygit"
    check_cmd stow "GNU stow"
    check_cmd glab "GitLab CLI"
    check_cmd shellcheck "ShellCheck"
    check_cmd yq "yq"
    check_cmd mongosh "mongosh"
    check_cmd psql "psql"
    check_cmd typst "Typst"
    check_cmd pandoc "Pandoc"

    echo ""
    echo -e "${CYAN}Kubernetes and secrets${RESET}"
    local tool
    for tool in kubectl helm k9s argocd minikube linkerd sops age; do
        if command -v "$tool" &>/dev/null; then ok "$tool"; else fail "$tool (not installed)"; fi
    done

    echo ""
    echo -e "${CYAN}Languages${RESET}"
    check_cmd python3 "Python"
    check_cmd uv "uv"
    if [[ -s "$HOME/.nvm/nvm.sh" ]]; then
        local nver
        nver="$(cat "$HOME/.nvm/alias/default" 2>/dev/null)"
        ok "nvm (default: ${nver:-none})"
    else
        fail "nvm (not installed)"
    fi
    check_cmd go "Go"
    check_cmd rustc "Rust"
    check_cmd cargo "Cargo"
    for tool in dlv govulncheck golangci-lint; do
        if command -v "$tool" &>/dev/null; then ok "$tool"; else fail "$tool (not installed; run setup/go.sh)"; fi
    done

    echo ""
    echo -e "${CYAN}Agent shell${RESET} ${DIM}(.zshrc as Claude Code / Codex snapshot it: non-interactive login, cold PATH)${RESET}"
    local probe node_path alias_count chpwd opts
    probe="$(env -i HOME="$HOME" USER="${USER:-}" PATH=/usr/bin:/bin zsh -lc '
        source ~/.zshrc
        printf "node=%s\n" "$(whence -p node)"
        printf "aliases=%s\n" "$(alias | wc -l | tr -d " ")"
        printf "chpwd=%s\n" "$(typeset -f chpwd >/dev/null 2>&1 && echo y || echo n)"
        printf "opts=%s\n" "$(setopt | grep -cE "^(nonomatch|noequals|bsdecho)$")"
    ' 2>&1)"
    node_path="$(sed -n 's/^node=//p' <<< "$probe")"
    alias_count="$(sed -n 's/^aliases=//p' <<< "$probe")"
    chpwd="$(sed -n 's/^chpwd=//p' <<< "$probe")"
    opts="$(sed -n 's/^opts=//p' <<< "$probe")"
    if [[ -x "$node_path" ]]; then ok "node resolves to a binary ($node_path)"; else fail "node does not resolve to a binary (got '${node_path:-nothing}')"; fi
    if [[ "$alias_count" == "0" ]]; then ok "no aliases"; else fail "${alias_count:-?} aliases leak into agent shells"; fi
    if [[ "$chpwd" == "n" ]]; then ok "no chpwd hook"; else fail "chpwd hook leaks into agent shells (every tool output gets an OSC 7 prefix)"; fi
    if [[ "$opts" == "3" ]]; then ok "bash-like options (no_nomatch no_equals bsd_echo)"; else fail "bash-like options not set (${opts:-?}/3)"; fi
    if grep -qvE '^(node|aliases|chpwd|opts)=' <<< "$probe"; then
        warn "agent shell startup printed output (should be silent):"
        grep -vE '^(node|aliases|chpwd|opts)=' <<< "$probe" | sed 's/^/      /'
    fi

    if [[ "$IS_WSL" -eq 1 ]]; then
        echo ""
        echo -e "${CYAN}WSL${RESET}"
        if systemctl is-active --quiet earlyoom.service; then
            ok "earlyoom running"
        else
            fail "earlyoom not running (run setup/wsl.sh)"
        fi
    fi

    echo ""
    echo -e "${CYAN}SSH${RESET}"
    if [[ -f "$HOME/.ssh/id_ed25519" ]]; then
        ok "SSH key (ed25519)"
    elif [[ -f "$HOME/.ssh/id_rsa" ]]; then
        warn "SSH key (rsa - consider switching to ed25519)"
    else
        fail "No SSH key found"
    fi

    echo ""
    echo -e "${CYAN}Config${RESET}"
    if [[ -f "$HOME/.gitconfig.local" ]]; then ok ".gitconfig.local"; else warn ".gitconfig.local (no local git config)"; fi
    if [[ -d "$HOME/.config/nvim" ]]; then ok "Neovim config"; else fail "Neovim config (missing ~/.config/nvim)"; fi
    if [[ -d "$HOME/.tmux/plugins/tpm" ]]; then ok "TPM (tmux plugins)"; else fail "TPM (not installed)"; fi

    echo ""
    if [[ "$DOCTOR_FAILURES" -eq 0 ]]; then
        ok "No health-check failures"
    else
        fail "$DOCTOR_FAILURES health-check failure(s)"
        return 1
    fi
}

update() {
    echo "Updating dotfiles..."
    cd "$DOTFILES_DIR"
    git pull --rebase

    echo "Restowing packages..."
    for pkg in shell git tmux wezterm bin; do
        if [[ -d "$DOTFILES_DIR/$pkg" ]]; then
            stow --restow --no-folding --target="$HOME" "$pkg" 2>/dev/null && echo "  ✓ $pkg" || echo "  ✗ $pkg (conflict)"
        fi
    done

    echo "Done."
}

# Categories: go and nvim here, the rest belong to setup/user-tools.sh.
upgrade() {
    if [[ $# -eq 0 ]]; then
        echo "Usage: dotfiles upgrade <category...|all>"
        echo "  go       Go toolchain, dlv, govulncheck, golangci-lint"
        echo "  nvim     Neovim"
        bash "$DOTFILES_DIR/setup/user-tools.sh" --help | tail -n +3
        return 1
    fi

    local category user_categories=() run_go=0 run_nvim=0 run_user=0
    for category in "$@"; do
        case "$category" in
            all) run_go=1; run_nvim=1; run_user=1 ;;
            go) run_go=1 ;;
            nvim) run_nvim=1 ;;
            *) user_categories+=("$category"); run_user=1 ;;
        esac
    done

    if [[ "$run_user" -eq 1 ]]; then
        bash "$DOTFILES_DIR/setup/user-tools.sh" --upgrade "${user_categories[@]}"
    fi
    if [[ "$run_go" -eq 1 ]]; then
        UPGRADE=1 bash "$DOTFILES_DIR/setup/go.sh"
    fi
    if [[ "$run_nvim" -eq 1 ]]; then
        bash "$DOTFILES_DIR/install.sh" --section neovim
    fi
}

edit() {
    cd "$DOTFILES_DIR"
    "${EDITOR:-nvim}" .
}

sync() {
    if [[ "$IS_WSL" -eq 0 ]]; then
        info "sync is only needed on WSL"
        return 0
    fi
    local windows_profile win_home=""
    # From /mnt/c, with stdin closed: cmd.exe in a Linux cwd warns about UNC
    # paths, and it reads (and eats) any piped stdin.
    windows_profile="$(cd /mnt/c && cmd.exe /d /c 'echo %USERPROFILE%' </dev/null 2>/dev/null | tr -d '\r')" || true
    # wslpath "" prints ".", which would write into the current directory.
    if [[ -n "$windows_profile" ]]; then
        win_home="$(wslpath -u "$windows_profile" 2>/dev/null || true)"
    fi
    if [[ "$win_home" != /* || ! -d "$win_home" ]]; then
        fail "Could not detect Windows home directory"
        return 1
    fi
    local rendered
    rendered="$(render_windows_wezterm)" || return 1
    printf '%s\n' "$rendered" > "$win_home/.wezterm.lua"
    ok "Copied .wezterm.lua to Windows ($win_home), default distro $WSL_DISTRO_NAME"
}

# The Windows copy opens the distro it was synced from. WSL_DISTRO in the
# Windows environment still overrides it when WezTerm starts.
render_windows_wezterm() {
    local src="$DOTFILES_DIR/wezterm/.wezterm.lua"
    local pattern="os.getenv('WSL_DISTRO') or '[^']*'"
    if [[ ! -f "$src" ]]; then
        fail "Source not found: $src"
        return 1
    fi
    if [[ -z "${WSL_DISTRO_NAME:-}" ]]; then
        fail "WSL_DISTRO_NAME is not set; cannot name the distro for WezTerm"
        return 1
    fi
    if ! grep -q "$pattern" "$src"; then
        fail "$src no longer has the WSL_DISTRO fallback this sync rewrites"
        return 1
    fi
    sed "s/$pattern/os.getenv('WSL_DISTRO') or '$WSL_DISTRO_NAME'/" "$src"
}

case "${1:-help}" in
    doctor) doctor ;;
    update) update ;;
    upgrade) shift; upgrade "$@" ;;
    edit)   edit ;;
    sync)   sync ;;
    *)
        echo "Usage: dotfiles <command>"
        echo ""
        echo "Commands:"
        echo "  doctor  Check health of installation"
        echo "  update  Pull latest and restow all packages"
        echo "  upgrade Reinstall tool categories at their latest release (no args: list)"
        echo "  edit    Open dotfiles repo in editor"
        echo "  sync    Copy configs to Windows side (WSL only)"
        ;;
esac
